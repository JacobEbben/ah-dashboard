{
  // Type-checks the browser code (JSDoc types + // @ts-check) without a build
  // step: `npm run typecheck` (see CLAUDE.md for the Docker command).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true
  },
  "include": ["ah_dashboard/static/js/**/*.js"]
}
