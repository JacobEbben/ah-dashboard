#!/usr/bin/env bash
# ah-iac: set up and run the AH Dashboard deployment from your own machine.
# Needs only bash and Docker: Ansible and its tools run in a throwaway
# container (deploy/tools/Dockerfile).
#
#   deploy/ah-iac configure          ask for the values (server, domain, certificates,
#                                    keys, settings, secrets) and write the inventory
#   deploy/ah-iac provision [args]   set up / update the whole server (site.yml);
#                                    extra args go to ansible-playbook (e.g. --check --diff, -k)
#   deploy/ah-iac deploy IMAGE       deploy <repo>@sha256:<digest> (CI does this on every main push)
#   deploy/ah-iac status | rollback | backup | restart
#   deploy/ah-iac vault-edit         edit the encrypted secrets
#   deploy/ah-iac github             print the GitHub secrets and variables to set
#   deploy/ah-iac check              lint and test the deployment code (no server needed)
#   deploy/ah-iac shell              a shell in the toolbox
#
# Local files (outside the repository):
#   $AH_IAC_HOME (default ~/.config/ah-dashboard)/vault-pass   password of the vault
#   $AH_IAC_HOME/deploy_key, deploy_key.pub                     CI deploy key pair
#   $AH_SSH_KEY (default ~/.ssh/id_ed25519)                      your SSH key for Ansible
# Other inventories: AH_INVENTORY=<name> (deploy/ansible/inventory/<name>).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INVENTORY="${AH_INVENTORY:-production}"
IAC_HOME="${AH_IAC_HOME:-$HOME/.config/ah-dashboard}"
VAULT_PASS="$IAC_HOME/vault-pass"
DEPLOY_KEY="$IAC_HOME/deploy_key"
SSH_KEY="${AH_SSH_KEY:-$HOME/.ssh/id_ed25519}"
TOOLS_IMAGE="ah-iac-tools"
INV_DIR="deploy/ansible/inventory/$INVENTORY"

die() { echo "ah-iac: $*" >&2; exit 1; }

build_tools() {
  docker build -q -t "$TOOLS_IMAGE" -f "$ROOT/deploy/tools/Dockerfile" "$ROOT/deploy" >/dev/null
}

github_owner() {
  git -C "$ROOT" -c safe.directory='*' remote get-url origin 2>/dev/null \
    | sed -nE 's#^(https://|git@)github\.com[:/]([^/]+)/.*#\2#p' | tr '[:upper:]' '[:lower:]'
}

# Run a command in the toolbox, in deploy/ansible, with the secrets mounted
# read-only. Root inside the container: the project folder may be a
# VirtualBox shared folder (only root can write there from a container).
tools() {
  build_tools
  local args=(--rm -i -v "$ROOT:/work" -w /work/deploy/ansible
              -e "ANSIBLE_INVENTORY=inventory/$INVENTORY/hosts.yml"
              -e "AH_INVENTORY_DIR=/work/$INV_DIR"
              -e "AH_GITHUB_OWNER=$(github_owner)"
              -e "ANSIBLE_FORCE_COLOR=1"
              -e "AH_HOST_IAC_HOME=$IAC_HOME" -e "AH_HOST_SSH_KEY=$SSH_KEY"
              # The host keys of THIS inventory (ansible.cfg's default is production's).
              -e "ANSIBLE_SSH_ARGS=-o ControlMaster=auto -o ControlPersist=60s -o StrictHostKeyChecking=yes -o UserKnownHostsFile=inventory/$INVENTORY/known_hosts -o IdentitiesOnly=yes")
  # Extra `docker run` options, e.g. AH_IAC_DOCKER_ARGS="--network vpn" (word-split on purpose).
  local extra=()
  read -r -a extra <<< "${AH_IAC_DOCKER_ARGS:-}"
  args+=("${extra[@]}")
  [[ -t 0 && -t 1 ]] && args+=(-t)
  [[ -f "$VAULT_PASS" ]] && args+=(-v "$VAULT_PASS:/secrets/vault-pass:ro" -e ANSIBLE_VAULT_PASSWORD_FILE=/secrets/vault-pass)
  [[ -f "$DEPLOY_KEY.pub" ]] && args+=(-v "$DEPLOY_KEY.pub:/secrets/deploy_key.pub:ro")
  if [[ -f "$SSH_KEY" ]]; then
    args+=(-v "$SSH_KEY:/secrets/ssh_key:ro" -e ANSIBLE_PRIVATE_KEY_FILE=/secrets/ssh_key)
    [[ -f "$SSH_KEY.pub" ]] && args+=(-v "$SSH_KEY.pub:/secrets/admin_key.pub:ro")
  elif [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
    args+=(-v "$SSH_AUTH_SOCK:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent)
  fi
  docker run "${args[@]}" "$TOOLS_IMAGE" "$@"
}

need_inventory() {
  [[ -f "$ROOT/$INV_DIR/hosts.yml" ]] || die "no inventory yet: run deploy/ah-iac configure first"
  [[ -f "$VAULT_PASS" ]] || die "vault password file $VAULT_PASS is missing (it was created by configure; restore it from your password manager)"
}

new_local_secrets() {
  mkdir -p "$IAC_HOME" && chmod 700 "$IAC_HOME"
  if [[ ! -f "$VAULT_PASS" ]]; then
    (umask 077 && head -c 48 /dev/urandom | base64 | tr -d '\n' > "$VAULT_PASS")
    echo "Created the vault password: $VAULT_PASS"
    echo "  Keep a copy in your password manager: without it the secrets can't be decrypted."
  fi
  if [[ ! -f "$DEPLOY_KEY" ]]; then
    if command -v ssh-keygen >/dev/null; then
      ssh-keygen -q -t ed25519 -N "" -C "ah-dashboard-ci-deploy" -f "$DEPLOY_KEY"
    else
      build_tools
      docker run --rm --user "$(id -u):$(id -g)" -v "$IAC_HOME:/k" "$TOOLS_IMAGE" \
        ssh-keygen -q -t ed25519 -N "" -C "ah-dashboard-ci-deploy" -f /k/deploy_key
    fi
    echo "Created the CI deploy key: $DEPLOY_KEY (private part goes into GitHub: deploy/ah-iac github)"
  fi
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  configure)
    new_local_secrets
    tools python3 /work/deploy/tools/configure.py
    echo; echo "Next: deploy/ah-iac provision   (then: deploy/ah-iac github)" ;;
  provision)
    need_inventory
    tools ansible-playbook site.yml "$@" ;;
  deploy)
    need_inventory
    [[ $# -ge 1 ]] || die "usage: deploy/ah-iac deploy <repo>@sha256:<digest>"
    image="$1"; shift
    tools ansible-playbook deploy.yml -e "app_image=$image" "$@" ;;
  status|rollback|backup|restart)
    need_inventory
    tools ansible-playbook ops.yml -e "ah_command=$cmd" "$@" ;;
  vault-edit)
    need_inventory
    tools ansible-vault edit "inventory/$INVENTORY/group_vars/all/vault.yml" ;;
  github)
    need_inventory
    tools python3 /work/deploy/tools/github_settings.py ;;
  check)
    bash "$ROOT/deploy/tests/run.sh" "$@" ;;
  shell)
    tools bash ;;
  help|-h|--help)
    sed -n '2,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$cmd' (deploy/ah-iac help)" ;;
esac
