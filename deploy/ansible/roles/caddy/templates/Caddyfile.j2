# {{ ansible_managed }} (deploy/ansible/roles/caddy): changes here are overwritten.
{
{% if tls_mode != 'internal' %}
	email {{ acme_email }}
{% endif %}
{% if tls_mode == 'letsencrypt-staging' %}
	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
{% endif %}
{% if caddy_https_port | int != 443 %}
	https_port {{ caddy_https_port }}
	http_port {{ caddy_http_port }}
{% endif %}
}

{{ domain }} {
{% if tls_mode == 'internal' %}
	tls internal
{% endif %}
	# The Bonus answer is large and Waitress doesn't compress.
	encode zstd gzip
	# No server identification (the app strips its own; CLAUDE.md security rules):
	# no Server header, and no "Via: 1.1 Caddy" (added by reverse_proxy since Caddy 2.10).
	header -Server
	header -Via
	# Caddy replaces any X-Forwarded-For a client sends with the real address,
	# so the app's TRUSTED_PROXY=* sees each visitor (limits, lockouts).
	reverse_proxy {{ app_upstream }}
}
{% if redirect_www %}

www.{{ domain }} {
{% if tls_mode == 'internal' %}
	tls internal
{% endif %}
	header -Server
	redir https://{{ domain }}{uri} permanent
}
{% endif %}
