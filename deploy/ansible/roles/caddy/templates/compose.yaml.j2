# {{ ansible_managed }} (deploy/ansible/roles/caddy)
# Caddy: HTTPS for the dashboard. Certificates and the ACME account live in the
# caddy-data volume: keep it (getting new certificates too often hits Let's
# Encrypt's rate limits).
name: {{ caddy_compose_project }}
services:
  caddy:
    image: {{ caddy_image }}
    container_name: {{ caddy_container }}
    restart: unless-stopped
    ports:
      - "{{ caddy_http_port }}:{{ caddy_http_port }}"
      - "{{ caddy_https_port }}:{{ caddy_https_port }}"
      - "{{ caddy_https_port }}:{{ caddy_https_port }}/udp"    # HTTP/3
    volumes:
      - ./conf:/etc/caddy:ro
      - caddy-data:/data
      - caddy-config:/config
    networks:
      - edge
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true

networks:
  edge:
    external: true
    name: {{ edge_network }}

volumes:
  caddy-data:
    name: {{ caddy_container }}-data
  caddy-config:
    name: {{ caddy_container }}-config
