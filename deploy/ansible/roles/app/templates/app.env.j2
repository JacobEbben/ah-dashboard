# {{ ansible_managed }} (deploy/ansible/roles/app): edit the inventory, not this file.
# Settings: .env.example. Readable by root only (secrets).
{% for key, value in app_settings | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% for key, value in app_managed | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% for key, value in app_secrets | dictsort %}
{% if value | length > 0 %}
{# Single quotes: the admin hash contains "$" (Compose would expand it). #}
{{ key }}='{{ value }}'
{% endif %}
{% endfor %}
