# {{ ansible_managed }} (deploy/ansible/roles/app). Changed only by ah-deploy:
# it writes the image into .env (AH_IMAGE) and stops the old container first.
name: {{ app_compose_project }}
services:
  app:
    image: ${AH_IMAGE:?deploy with ah-deploy}
    container_name: {{ app_container }}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      HOST: 0.0.0.0
      PORT: "8733"
    # No ports: only Caddy (same network) can reach the app.
    networks:
      - edge
    volumes:
      - {{ app_volume_instance }}:/app/instance   # SQLite database (users, settings, encrypted AH login)
      - {{ app_volume_logs }}:/app/logs           # errors.log
    # The image's health check, probed every 2 s while starting so a deploy
    # needs seconds, not the 30 s interval.
    healthcheck:
      start_period: 60s
      start_interval: 2s
    stop_grace_period: 30s
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true

networks:
  edge:
    external: true
    name: {{ edge_network }}

volumes:
  {{ app_volume_instance }}:
    name: {{ app_volume_instance }}
  {{ app_volume_logs }}:
    name: {{ app_volume_logs }}
