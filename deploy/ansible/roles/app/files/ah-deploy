#!/usr/bin/env bash
# ah-deploy: the only way the AH Dashboard container is changed on the server
# (installed by deploy/ansible/roles/app; settings in /etc/ah-deploy.conf).
#
#   ah-deploy deploy <repo>@sha256:<digest>   back up, switch image, check health,
#                                             roll back automatically when unhealthy
#   ah-deploy rollback                        go back to the previous image
#   ah-deploy restart                         recreate the current image (new app.env)
#   ah-deploy backup                          back up the database now (short stop)
#   ah-deploy status                          images, health, last backup
#
# Rules this script keeps (CLAUDE.md "Things that must not change"):
# - ONE app process: the old container is stopped before the new one starts
#   (AH rotates the refresh token; two copies would invalidate each other's).
# - Database versions only go up: a backup is taken before every image change,
#   and a rollback restores it only when the older image refuses the database.
set -euo pipefail
umask 077

CONF="${AH_DEPLOY_CONF:-/etc/ah-deploy.conf}"
# shellcheck source=/dev/null
. "$CONF"
: "${IMAGE_REPO:?}" "${COMPOSE_DIR:?}" "${CONTAINER:?}" "${VOLUME_INSTANCE:?}" "${BACKUP_DIR:?}"
BACKUP_KEEP="${BACKUP_KEEP:-10}"
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-180}"
LOCK_FILE="${LOCK_FILE:-/run/lock/ah-deploy.lock}"
PUBLIC_URL="${PUBLIC_URL:-}"
STATE="$COMPOSE_DIR/state"

log() { printf '%s ah-deploy: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

valid_image() {
  local digest="${1#"$IMAGE_REPO@sha256:"}"
  [[ "$1" == "$IMAGE_REPO@sha256:"* && "$digest" =~ ^[0-9a-f]{64}$ ]]
}

compose() { docker compose --project-directory "$COMPOSE_DIR" "$@"; }
state_get() { cat "$STATE/$1" 2>/dev/null || true; }
state_set() { printf '%s\n' "$2" > "$STATE/$1.tmp" && mv "$STATE/$1.tmp" "$STATE/$1"; }
volume_exists() { docker volume inspect "$VOLUME_INSTANCE" >/dev/null 2>&1; }

# Stop the app (if it runs). Never two copies at once.
stop_app() { compose stop --timeout 30 >/dev/null 2>&1 || true; }

start_app() {
  printf 'AH_IMAGE=%s\n' "$1" > "$COMPOSE_DIR/.env"   # read by compose.yaml (${AH_IMAGE})
  compose up -d --force-recreate --remove-orphans >/dev/null
}

# Wait until Docker's health check (GET /healthz in the image) says healthy.
# A crash loop fails at once: Docker restarts the container (restart policy)
# and its health status would stay "starting" until the timeout.
wait_healthy() {
  local waited=0 state health restarts
  while (( waited < HEALTH_TIMEOUT )); do
    read -r state health restarts < <(docker inspect --format \
      '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} {{.RestartCount}}' \
      "$CONTAINER" 2>/dev/null || echo "missing none 0")
    if [[ "$health" == healthy ]]; then
      return 0
    fi
    if [[ "$health" == unhealthy || "$state" =~ ^(exited|dead|restarting)$ || "$restarts" -gt 0 ]] \
       || [[ "$state" == missing && $waited -gt 10 ]]; then
      log "container is $state (health: $health, restarts: $restarts)"
      return 1
    fi
    sleep 3; waited=$((waited + 3))
  done
  log "not healthy after ${HEALTH_TIMEOUT}s"
  return 1
}

show_logs() { docker logs --tail 40 "$CONTAINER" 2>&1 | sed 's/^/    | /' >&2 || true; }

# Back up the instance volume (database, its WAL) with the app STOPPED, using
# the given (already pulled) image for tar. Prints the backup file name.
backup_volume() {
  local image="$1" name
  volume_exists || { log "no data volume yet: nothing to back up"; return 0; }
  mkdir -p "$BACKUP_DIR"
  name="$(date -u +%Y%m%dT%H%M%SZ)-$(cut -c1-12 <<< "${image##*@sha256:}").tar.gz"
  docker run --rm --network none --user 0 --entrypoint tar \
    -v "$VOLUME_INSTANCE":/data:ro -v "$BACKUP_DIR":/backup "$image" \
    --numeric-owner -czf "/backup/$name" -C /data .
  state_set last_backup "$name"
  # Keep the newest BACKUP_KEEP backups.
  find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -printf '%T@ %f\n' | sort -rn | tail -n +"$((BACKUP_KEEP + 1))" \
    | cut -d' ' -f2- | while read -r old; do rm -f -- "$BACKUP_DIR/$old"; done
  log "backup: $BACKUP_DIR/$name"
  printf '%s\n' "$name"
}

restore_volume() {
  local image="$1" name="$2"
  [[ -f "$BACKUP_DIR/$name" ]] || die "backup $name not found"
  log "restoring the database from $name"
  docker run --rm --network none --user 0 --entrypoint sh \
    -v "$VOLUME_INSTANCE":/data -v "$BACKUP_DIR":/backup:ro "$image" \
    -c 'find /data -mindepth 1 -delete && tar --numeric-owner -xzf "/backup/$1" -C /data' sh "$name"
}

# Remove pulled images of this repo except the current and previous one.
prune_images() {
  local keep_a="$1" keep_b="$2" ref
  docker images --digests --format '{{.Repository}}@{{.Digest}}' "$IMAGE_REPO" | while read -r ref; do
    [[ "$ref" == "$keep_a" || "$ref" == "$keep_b" || "$ref" == *"<none>"* ]] || docker rmi "$ref" >/dev/null 2>&1 || true
  done
}

public_check() {
  [[ -n "$PUBLIC_URL" ]] || return 0
  if curl -fsS -o /dev/null --max-time 10 "$PUBLIC_URL/healthz"; then
    log "public check ok: $PUBLIC_URL/healthz"
  else
    log "WARNING: $PUBLIC_URL/healthz not reachable through Caddy (DNS, certificate or Caddy?)"
  fi
}

# Go back to an older image: first with the current database; if the older
# app refuses it (a newer schema), restore the backup taken before the change.
rollback_to() {
  local image="$1" backup="${2:-}"
  log "rolling back to $image"
  stop_app
  start_app "$image"
  if wait_healthy; then
    log "rolled back; the database was kept"
    return 0
  fi
  show_logs
  [[ -n "$backup" ]] || die "rollback failed and there is no backup to restore"
  stop_app
  restore_volume "$image" "$backup"
  start_app "$image"
  wait_healthy || { show_logs; die "rollback failed even with the backup restored"; }
  log "rolled back and restored backup $backup: changes since then are lost."
  log "If AH renewed its token meanwhile, log in to AH again in /admin (login code)."
}

cmd_deploy() {
  local image="$1" previous backup=""
  valid_image "$image" || die "refusing '$image': only $IMAGE_REPO@sha256:<64 hex> can be deployed"
  log "pulling $image"
  docker pull --quiet "$image" >/dev/null
  previous="$(state_get current)"
  if [[ "$previous" == "$image" ]] && wait_healthy; then
    log "already running $image"; return 0
  fi
  stop_app
  backup="$(backup_volume "$image")"
  start_app "$image"
  if wait_healthy; then
    state_set current "$image"
    if [[ -n "$previous" && "$previous" != "$image" ]]; then
      state_set previous "$previous"
      # The database as the previous image left it: what `rollback` restores if
      # that image refuses the database the new one may have upgraded.
      state_set rollback_backup "$backup"
    fi
    prune_images "$image" "$(state_get previous)"
    log "deployed $image"
    public_check
    return 0
  fi
  log "the new image is not healthy:"
  show_logs
  if [[ -n "$previous" ]]; then
    rollback_to "$previous" "$backup"
    state_set current "$previous"
  fi
  die "deploy of $image failed${previous:+ (rolled back to $previous)}"
}

cmd_rollback() {
  local current previous
  current="$(state_get current)"; previous="$(state_get previous)"
  [[ -n "$previous" ]] || die "no previous image to roll back to"
  rollback_to "$previous" "$(state_get rollback_backup)"
  state_set current "$previous"
  state_set previous "$current"
  state_set rollback_backup ""   # going forward again needs no restore
  public_check
}

cmd_restart() {
  local current; current="$(state_get current)"
  [[ -n "$current" ]] || { log "nothing deployed yet"; return 0; }
  stop_app
  start_app "$current"
  wait_healthy || { show_logs; die "restart failed: check app.env (ah-iac provision) or roll back"; }
  log "restarted $current"
}

cmd_backup() {
  local current; current="$(state_get current)"
  [[ -n "$current" ]] || die "nothing deployed yet"
  stop_app
  backup_volume "$current" >/dev/null
  start_app "$current"
  wait_healthy || { show_logs; die "the app did not come back after the backup"; }
}

cmd_status() {
  printf 'current:     %s\n' "$(state_get current || true)"
  printf 'previous:    %s\n' "$(state_get previous || true)"
  printf 'container:   %s\n' "$(docker inspect --format '{{.State.Status}} {{if .State.Health}}({{.State.Health.Status}}){{end}} since {{.State.StartedAt}}' "$CONTAINER" 2>/dev/null || echo 'not running')"
  printf 'last backup: %s\n' "$(state_get last_backup || true)"
  printf 'rollback db: %s\n' "$(state_get rollback_backup || true)"
  printf 'backups:     %s in %s\n' "$(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' 2>/dev/null | wc -l)" "$BACKUP_DIR"
}

main() {
  mkdir -p "$STATE"
  exec 9>"$LOCK_FILE"
  flock -n 9 || die "another ah-deploy is running"
  case "${1:-}" in
    deploy)   [[ $# -eq 2 ]] || die "usage: ah-deploy deploy <image@sha256:digest>"; cmd_deploy "$2" ;;
    rollback) cmd_rollback ;;
    restart)  cmd_restart ;;
    backup)   cmd_backup ;;
    status)   cmd_status ;;
    *) die "usage: ah-deploy deploy <image@sha256:digest> | rollback | restart | backup | status" ;;
  esac
}

main "$@"
