# Environment settings. Copy this file to .env (next to compose.yaml) and fill
# in what you need; `docker compose` passes it into the container. .env is in
# .gitignore and .dockerignore: it holds your AH login, keep it private.

# --- Server-side AH login (REQUIRED) -------------------------------------------
# The app calls AH with this one login; users of the app need no token.
# Get both values from AH's login flow (POST /mobile-auth/v1/auth/token).
# AH replaces the refresh token on every renewal; the app keeps the current
# pair encrypted in the database (DATABASE_FILE), so these values are only read
# once. Setting a NEW AH_REFRESH_TOKEN here replaces the stored pair (that is
# how you log in again). Only the refresh token is strictly required.
AH_ACCESS_TOKEN=
AH_REFRESH_TOKEN=
# Minimum seconds between token renewals (stops loops if AH fails otherwise)
AH_REFRESH_COOLDOWN=300
# AH_AUTH_REFRESH_URL=https://api.ah.nl/mobile-auth/v1/auth/token/refresh
# AH_CLIENT_ID=appie-ios

# Secret used to encrypt the stored AH tokens (min. 16 chars). If unset, one
# is generated once into instance/token_seal.secret. Changing it makes the
# stored tokens unreadable (then the AH_* values above are used again).
# TOKEN_SEAL_SECRET=change-me-to-a-long-random-string

# --- Admin panel (/admin): on with a password hash or an admin user ------------
# Lets you set the AH tokens and renew them from the browser. Create the hash
# with `docker compose run --rm ah-dashboard python -m ah_dashboard.admin` (only the hash is stored, never the
# password). Without it and without an admin user (promoted in the panel), /admin
# does not exist (404). The password is the emergency way in. Keep the value in single
# quotes: the hash contains "$", which Docker Compose would otherwise expand.
ADMIN_PASSWORD_HASH=
# Who to contact about privacy (an e-mail address or a URL), shown on /privacy.
# Leave empty to show no contact.
PRIVACY_CONTACT=

# --- MCP endpoint for AI assistants ------------------------------------------------
# /mcp offers read-only tools (store search, bargains, Bonus) to MCP clients such
# as Claude: the same public data as the dashboard, anonymous. false = off (404).
MCP_ENABLED=true
# An admin-PASSWORD session ends after this many minutes without admin activity
# (admin users signed in with Google are admin for as long as they are signed in) ...
ADMIN_SESSION_MINUTES=60
# ... and at the latest this many hours after the password login, however active
ADMIN_SESSION_MAX_HOURS=8
# Lock an IP address out after this many wrong passwords within the window
ADMIN_MAX_FAILURES=5
ADMIN_LOCKOUT_SECONDS=900
# Lock the admin password after this many failures from any addresses within
# the window (users sign in with Google and have no password)
ACCOUNT_MAX_FAILURES=20
# true = session cookie only over HTTPS, plus HSTS (set this when serving via HTTPS)
ADMIN_COOKIE_SECURE=false

# --- Dashboard users: sign in with Google -------------------------------------------
# Signing in is optional; it syncs a user's settings across devices. Anyone with
# a verified Google account can sign in (the first sign-in creates the account).
# Create an OAuth client ("Web application") in Google Cloud Console and add the
# redirect URI <PUBLIC_BASE_URL>/auth/google/callback, e.g.
# http://127.0.0.1:8733/auth/google/callback locally. Empty: no sign-in (the
# admin password still opens /admin).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The site's public address, no path (https://ah.example.nl). Empty: taken from
# the request (fine locally; set it behind a proxy).
PUBLIC_BASE_URL=
# New accounts are refused beyond this many users
MAX_USERS=1000
# Users, their settings and the encrypted AH login are kept in one SQLite file.
# DATABASE_FILE=         (default: instance/ah_dashboard.db)
USER_SESSION_DAYS=30

# --- Server --------------------------------------------------------------------
# production | development | testing
APP_ENV=production
# Inside the container compose.yaml sets HOST=0.0.0.0; the port is published on
# 127.0.0.1 only. Put a reverse proxy (HTTPS, rate limiting) in front before
# exposing it: everyone who can reach the app uses your AH login.
HOST=127.0.0.1
PORT=8733
# Waitress worker threads
THREADS=8
# Behind a reverse proxy (Caddy): the proxy's address, or * when only the proxy
# can reach the app. Then the client address comes from X-Forwarded-For, so
# login lockouts and rate limits are per visitor. Empty = no proxy.
TRUSTED_PROXY=
TRUSTED_PROXY_COUNT=1

# --- Protecting the shared AH login ------------------------------------------------
# Requests per client address per window (0 = off) for the endpoints that can
# make the server call AH.
RATE_LIMIT_BARGAINS=30
RATE_LIMIT_BARGAINS_SECONDS=60
RATE_LIMIT_STORES=10
RATE_LIMIT_STORES_SECONDS=60
RATE_LIMIT_BONUS=30
RATE_LIMIT_BONUS_SECONDS=60
# MCP endpoint (/mcp): JSON-RPC messages per client per window. Its tools also
# count against the limits above.
RATE_LIMIT_MCP=120
RATE_LIMIT_MCP_SECONDS=60
# At most this many AH requests in flight at once (whole server)
AH_MAX_CONCURRENT=8
# AH requests may start at this rate (per second, whole server), in bursts of
# at most AH_RATE_BURST; AH blocks quick bursts of ~160 requests. 0 = no pacing.
AH_RATE_PER_SECOND=2
AH_RATE_BURST=10
# After AH refuses us ("Access Denied" / HTTP 429): no AH requests for this many seconds
AH_THROTTLE_PAUSE_SECONDS=900
# Serve a store's bargains this many seconds past the TTL while reloading them
BARGAINS_STALE_SECONDS=600
# Don't ask AH again for a store that failed, for this many seconds
STORE_ERROR_TTL=120
# Store search results per postal code (seconds)
STORE_SEARCH_CACHE_TTL=86400
# Loads of stores from AH (cache misses) per minute, per client and in total
STORE_LOADS_PER_CLIENT=40
STORE_LOADS_TOTAL=120
# Store ids not known to exist (not from a store search, no bargains seen yet):
# loads per client and in total, per window (seconds)
UNKNOWN_STORES_PER_CLIENT=10
UNKNOWN_STORES_TOTAL=60
UNKNOWN_STORES_WINDOW=3600
# Admin-password attempts per minute for the whole server (before password hashing)
LOGIN_ATTEMPTS_PER_MINUTE=60
# Google sign-ins started per minute per client address
GOOGLE_SIGNIN_PER_MINUTE=10
# Settings uploads per minute per signed-in user
PREFS_WRITES_PER_MINUTE=60
# Load the Bonus in the background (start-up, week change)
BONUS_PREWARM=true

LOG_LEVEL=INFO

# Error details are written here (rotating file); users only see generic
# messages with a reference ID that matches the log entry. Empty = disabled.
ERROR_LOG_FILE=logs/errors.log
ERROR_LOG_MAX_BYTES=1000000
ERROR_LOG_BACKUPS=5

# --- AH API --------------------------------------------------------------------
# Must be https:// (the app refuses to start otherwise)
AH_GRAPHQL_URL=https://api.ah.nl/graphql
# Seconds per request to AH
AH_TIMEOUT=20
# Max stores per bargains request
MAX_STORES=25
# Stores fetched from AH in parallel
MAX_WORKERS=6

# --- Cache of AH bargains (in memory, per store, shared by all users) ---------
# Refresh serves data younger than this from the cache (seconds; 300 = 5 min)
BARGAINS_CACHE_TTL=300
# The Bonus is cached until its week ends; partial loads are retried after:
BONUS_RETRY_SECONDS=300
BARGAINS_CACHE_MAX_STORES=2000


# Background jobs (Bonus pre-warm, pruning expired sign-ins). Leave on in production.
# BACKGROUND_JOBS=true
